{
  "name": "yasiro-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "shots": "node scripts/screenshot.mjs",
    "test:coverage": "vitest run --coverage",
    "games:seed": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/games-seed.ts",
    "games:export": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/games-export.ts",
    "games:edit": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/games-edit.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260620.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.64.1",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
